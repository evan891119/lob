#!/bin/sh
set -eu

test "$(id -u)" -eq 0 || { echo "run with sudo" >&2; exit 1; }
test "$#" -eq 4 \
  || { echo "usage: sudo scripts/pilot-check ABSOLUTE_DATA_ROOT HOST_ENV_FILE START_DATE END_DATE" >&2; exit 2; }

data_root="$1"
host_env="$2"
start_date="$3"
end_date="$4"

printf '%s\n' "$start_date" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' \
  || { echo "pilot start date must use YYYY-MM-DD" >&2; exit 1; }
printf '%s\n' "$end_date" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' \
  || { echo "pilot end date must use YYYY-MM-DD" >&2; exit 1; }
test "$start_date" \< "$end_date" || test "$start_date" = "$end_date" \
  || { echo "pilot start date must be on or before end date" >&2; exit 1; }

scripts/acceptance-check "$data_root" "$host_env"

docker compose --env-file "$host_env" exec -T collector \
  lob-recorder pilot-report \
  --host clickhouse \
  --start-date "$start_date" \
  --end-date "$end_date" \
  --output /var/lib/lob/parquet/pilot-report.json

echo "pilot check complete; privacy-safe reports written to the data-root parquet area"
